# ComicBookTTS Configuration Template
# Copy this file to config.properties and configure your settings

# Android TTS Configuration
# These settings control the built-in Android Text-to-Speech engine
tts.speech_rate=1.0
tts.pitch=1.0
tts.preferred_engine=com.google.android.tts
tts.voice_quality=high

# Voice Character Settings for Comics
tts.dialogue_rate=0.9
tts.narration_rate=0.8
tts.sound_effects_enabled=false

# OCR Settings
ocr.max_image_dimension=2048
ocr.enable_preprocessing=true

# App Settings
app.auto_play_delay_ms=1000
app.max_recent_comics=10