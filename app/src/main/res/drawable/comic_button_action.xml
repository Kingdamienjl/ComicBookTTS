<?xml version="1.0" encoding="utf-8"?>
<!-- Comic action button: orange accent with hard shadow + highlight.
     Rebuilt 2026-10-11 from IMPLEMENTATION_SUMMARY_2026-01.md spec. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard drop shadow -->
    <item
        android:left="0dp"
        android:top="4dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#4E2600" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Button face -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFB74D"
                android:centerColor="#FF9800"
                android:endColor="#E65100" />
            <corners android:radius="10dp" />
            <stroke
                android:width="3dp"
                android:color="#000000" />
        </shape>
    </item>
    <!-- Top highlight -->
    <item
        android:left="6dp"
        android:top="4dp"
        android:right="6dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#B3FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp"
                android:bottomLeftRadius="2dp"
                android:bottomRightRadius="2dp" />
        </shape>
    </item>
</layer-list>
