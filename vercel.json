{
  "version": 2,
  "name": "comicbook-tts",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "README.md",
      "use": "@vercel/static"
    }
  ],
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/download",
      "dest": "/ComicBookTTS.apk",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=ComicBookTTS.apk"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "ANDROID_HOME": "/opt/android-sdk",
    "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk"
  },
  "build": {
    "env": {
      "ANDROID_COMPILE_SDK": "34",
      "ANDROID_BUILD_TOOLS": "34.0.0",
      "ANDROID_SDK_TOOLS": "34.0.0"
    }
  },
  "github": {
    "silent": true
  }
}